# Firma de la cookie de sesión (mínimo 32 caracteres; obligatoria en producción). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Llave con la que se calcula la huella (HMAC) de CURP y NSS, que no se guardan en claro (mínimo 32
# caracteres; obligatoria en producción). Respáldala: si se pierde o cambia, las huellas guardadas dejan de
# coincidir. Genera una igual que la anterior.
PII_HASH_KEY=
# Proveedor de datos: "memory" (dummy, por defecto) | "azure" (Azure SQL Server)
DATA_PROVIDER=memory
# Azure SQL Server: cadena de conexión (formato ADO.NET u ODBC de Azure; la contraseña va aquí, nunca en el repo)
#   Server=tcp:<servidor>.database.windows.net,1433;Database=<bd>;User ID=<usuario>;Password=<contraseña>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;
# Con Microsoft Entra ID (sin contraseña en la cadena; en local requiere `az login`):
#   Server=tcp:<servidor>.database.windows.net,1433;Database=<bd>;Authentication=ActiveDirectoryDefault;Encrypt=yes;
# Valores de Authentication: SqlPassword (por omisión), ActiveDirectoryDefault, ActiveDirectoryManagedIdentity
# (User Id = client id si la identidad administrada es de usuario) y ActiveDirectoryServicePrincipal
# (User Id = client id, Password = secreto, Tenant Id = tenant).
AZURE_SQL_CONNECTION_STRING=
# Conexiones del pool: máximas (por omisión 10) y mínimas siempre abiertas (por omisión 1)
DATABASE_POOL_MAX=
DATABASE_POOL_MIN=
# Archivos subidos (documentos de contratistas): carpeta donde se guardan.
# En producción debe apuntar a un disco persistente (los archivos no se guardan en la BD).
# (obligatoria en producción; en desarrollo, por omisión ./almacenamiento_local)
STORAGE_DIR=
# URL pública de la app (con https). Va dentro del QR de acceso a planta para que la cámara del teléfono lo abra.
# Si se omite se toma del host de la petición.
APP_BASE_URL=https://tfs-hsea-bnhqc9g4bbhmcdg5.eastus-01.azurewebsites.net
# Notificaciones push (firmas pendientes). Llaves VAPID: se generan UNA vez y se respaldan; si cambian, todos los
# dispositivos dejan de recibir avisos hasta volver a activarlos. Genéralas con:
#   npx web-push generate-vapid-keys
# Sin estas tres variables la campana no aparece y no se envían avisos ni recordatorios.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del responsable que verán los servicios de push (mailto: o https:)
VAPID_SUBJECT=mailto:hsea@ejemplo.com
