# dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build de Next.js
/.next
/out
/build
next-env.d.ts
*.tsbuildinfo

# variables de entorno: nunca se suben (secretos, URL de la base, llaves). Solo la plantilla.
.env
.env.*
!.env.example

# archivos subidos en desarrollo (documentos y fotos de personas; en producción viven en el volumen de Railway)
/almacenamiento_local

# pruebas y cobertura
/coverage
/.vitest
*.lcov

# registros y volcados
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.dump
*.sql.bak

# Vercel / Railway locales
.vercel
.railway

# sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# editores (se conserva la configuración compartida de VS Code)
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Claude Code: configuración personal y archivos temporales (las skills del proyecto sí se versionan)
.claude/settings.local.json
.claude/scratch/
.claude/worktrees/
.agents/
